CREATE TABLE IF NOT EXISTS products (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    product_type VARCHAR(100) NOT NULL,
    sales_price DECIMAL(12,2) NOT NULL,
    cost_price DECIMAL(12,2) DEFAULT 0,
    notes TEXT,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS product_variants (
    id INT AUTO_INCREMENT PRIMARY KEY,
    product_id INT NOT NULL,
    variant_name VARCHAR(150) NOT NULL,
    additional_price DECIMAL(12,2) NOT NULL DEFAULT 0,
    FOREIGN KEY (product_id) REFERENCES products(id)
        ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS subscription_plans (
    id INT AUTO_INCREMENT PRIMARY KEY,
    product_id INT NOT NULL,
    plan_name VARCHAR(150) NOT NULL,
    billing_cycle ENUM('DAILY','WEEKLY','MONTHLY','YEARLY') NOT NULL,
    price DECIMAL(12,2) NOT NULL,
    minimum_quantity INT DEFAULT 1,
    start_date DATE,
    end_date DATE,
    allow_pause BOOLEAN DEFAULT TRUE,
    allow_early_close BOOLEAN DEFAULT TRUE,
    auto_renew BOOLEAN DEFAULT FALSE,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (product_id) REFERENCES products(id)
);

CREATE TABLE IF NOT EXISTS taxes (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tax_name VARCHAR(100) NOT NULL,
    tax_rate DECIMAL(5,2) NOT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS discounts (
    id INT AUTO_INCREMENT PRIMARY KEY,
    discount_name VARCHAR(150) NOT NULL,
    discount_type ENUM('FIXED','PERCENTAGE') NOT NULL,
    discount_value DECIMAL(12,2) NOT NULL,
    minimum_purchase DECIMAL(12,2) DEFAULT 0,
    minimum_quantity INT DEFAULT 1,
    product_id INT NULL,
    start_date DATE,
    end_date DATE,
    usage_limit INT NULL,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (product_id) REFERENCES products(id)
);